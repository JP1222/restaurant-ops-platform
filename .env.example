APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
INTERNAL_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_BASE_URL=
NEXT_PUBLIC_DEFAULT_MERCHANT_ID=
BOARD_TIMEZONE=UTC
NEXT_PUBLIC_BOARD_TIMEZONE=UTC
API_PORT=4000

CLOVER_REGION=US
CLOVER_BASE_URL=https://api.clover.com
# Optional token-mode bootstrap/fallback. Prefer saving the active merchant token
# from /admin/integrations/clover so runtime Clover config lives in the database.
CLOVER_MERCHANT_ID=
CLOVER_TOKEN=
# Optional Clover OAuth app credentials if you decide to use merchant-authorized installs later.
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_WEBHOOK_AUTH_CODE=

# Deliverect route/config support. Defaults are safe for local dev; set the
# webhook secret when validating signed Deliverect webhook requests.
DELIVERECT_API_URL=https://api.deliverect.com
DELIVERECT_STAGING_API_URL=https://api.staging.deliverect.com
DELIVERECT_WEBHOOK_SECRET=
DELIVERECT_WEBHOOK_SIGNATURE_HEADER=x-server-authorization-hmac-sha256

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rop_kds?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=postgres

# --- Inventory (apps/inventory-api + packages/db-inventory) ---
# inventory-api owns its own Postgres database (Iron Law 1). In dev this is the
# `postgres-inventory` service in docker-compose.dev.yml on port 5433.
INVENTORY_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rop_inventory?schema=public
INVENTORY_API_PORT=4100
CREW_BASE_URL=http://localhost:3003
# Backoffice BFF -> inventory-api base URL (server-side only; never exposed to the browser).
INTERNAL_INVENTORY_API_URL=http://localhost:4100
# Bearer token for trusted server-to-server writes (backoffice BFF -> inventory-api).
# Generate with: openssl rand -hex 32. Required in production; blank = writes refused in prod.
INVENTORY_INTERNAL_TOKEN=
# notifications-api (operator bell/inbox). Its own Postgres + service port.
# Port 5435: 5434 is already taken by postgres-analytics in docker-compose.dev.yml.
NOTIFICATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/rop_notifications?schema=public
NOTIFICATIONS_API_PORT=4400
# Backoffice BFF -> notifications-api. Leave INTERNAL_NOTIFICATIONS_API_URL BLANK to
# keep the bell/inbox on the bundled sample data; set it to go live (ADR-0801 Phase 3).
# The token bearer-guards every route; generate with: openssl rand -hex 32.
INTERNAL_NOTIFICATIONS_API_URL=
NOTIFICATIONS_INTERNAL_TOKEN=
# --- CRM / loyalty (apps/crm-api + packages/db-crm, ADR-0021) ---
# crm-api owns its own Postgres database (Iron Law 1). In dev this is the
# `postgres-crm` service in docker-compose.dev.yml on port 5436. crm-api is started
# on demand (not in `make dev`); see scripts/dev-defaults.sh for the local default.
CRM_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/rop_crm?schema=public
CRM_API_PORT=4200
# Backoffice BFF -> crm-api (the /guests loyalty-cohorts page). Leave
# INTERNAL_CRM_API_URL BLANK to keep /guests "not connected"; set it (and start
# crm-api) to go live. crm-api is open without a token in dev and fails closed only
# in production — set CRM_INTERNAL_TOKEN on BOTH ends to exercise the bearer.
# Generate with: openssl rand -hex 32 (>=16 chars).
INTERNAL_CRM_API_URL=
CRM_INTERNAL_TOKEN=
# crm loyalty-accrual worker (separate process; `pnpm --filter @rop/crm-api
# dev:worker`). Point CRM_REDIS_URL at the SAME Redis kds-api uses so it drains the
# shared crm-loyalty-accrual queue. Optional — the HTTP server boots without it.
CRM_REDIS_URL=
# Crew PIN auth (Phase 5). inventory-api signs crew session tokens with
# CREW_SESSION_SECRET and derives the PIN lookup index with CREW_PIN_PEPPER. Both
# are REQUIRED in production (crew login fails closed without them); blank = dev
# defaults that match the db-inventory seed. Generate each with
# `openssl rand -hex 32` and keep the two values different.
CREW_SESSION_SECRET=
CREW_PIN_PEPPER=
# crew-web BFF -> inventory-api base URL (server-side only; never exposed to the browser).
INVENTORY_API_BASE_URL=http://localhost:4100
SESSION_SECRET=replace-me-with-a-long-random-string
WEB_LOGIN_USERNAME=yradmin
WEB_LOGIN_PASSWORD_HASH=
WEB_LOGIN_DISPLAY_NAME=Kitchen Admin
# Local Codex/UI review only. Never enable this in production.
WEB_AUTH_DEV_BYPASS=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Example Kitchen KDS
WEB_SESSION_TTL_HOURS=12

# Bearer token that lets internal services (Backoffice) call /api/admin/* on
# kds-api without a browser session. Generate with: openssl rand -hex 32
# Must match backoffice-web's KDS_INTERNAL_ADMIN_TOKEN env exactly. Leave
# blank to disable internal admin (all /api/admin/kds/* return 503).
KDS_INTERNAL_ADMIN_TOKEN=

RECONCILE_INTERVAL_MS=45000
KDS_WORKER_CONCURRENCY=8
KDS_FULFILLMENT_WORKER_CONCURRENCY=4
KDS_CLOVER_BUCKET_REALTIME=10:10
KDS_CLOVER_BUCKET_RECON=6:6
KDS_CLOVER_BUCKET_GLOBAL=12:12
KDS_REALTIME_BACKFILL_LIMIT=250
DAILY_RESET_ENABLED=false
DAILY_RESET_HOUR=21
DAILY_RESET_MINUTE=0
DAILY_RESET_TIMEZONE=UTC
DAILY_RESET_CHECK_INTERVAL_MS=30000

# AI Assistant — production hardening (backoffice-web). These are
# AppSetting-backed env fallbacks (ADR-0016); see settings.ts for the registry.
# Set to "true" to immediately disable /api/ai/chat (returns 503). Used as a
# spend kill-switch when DeepSeek usage creeps over budget.
AI_MONTHLY_SPEND_KILL_SWITCH=false

# Requests-per-minute cap (global, single-operator). Defaults to 10 if unset.
AI_RATE_LIMIT_PER_MINUTE=10

# Deliverect at-rest encryption (Phase 4.5). Master key for the cipher columns
# in kds_provider_configs (apiToken / hmacSecret). This is now its only
# consumer — the AI assistant moved to DeepSeek single-env-var auth and the
# ai_auth_profiles table was dropped (ADR-0017).
# Generate a fresh 32-byte hex value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: store this in a password manager out-of-band. If lost, every
# encrypted Deliverect credential becomes unreadable and the operator must
# re-enter them via Backoffice /admin/integrations.
AI_TOKEN_ENCRYPTION_KEY=
