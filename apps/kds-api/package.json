{
  "name": "@rop/kds-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=yr-src' tsx watch src/index.ts",
    "dev:worker": "NODE_OPTIONS='--conditions=yr-src' tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "@sentry/node": "^10.68.0",
    "@simplewebauthn/server": "^13.3.2",
    "@rop/auth": "workspace:*",
    "@rop/contracts": "workspace:*",
    "@rop/db-auth": "workspace:*",
    "@rop/db-kds": "workspace:*",
    "bullmq": "^5.81.2",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "prom-client": "^15.1.3",
    "square": "^44.2.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.23.1"
  }
}
