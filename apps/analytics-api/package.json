{
  "name": "@rop/analytics-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "NODE_OPTIONS='--conditions=yr-src' tsx watch src/service.ts",
    "start": "node dist/src/service.js",
    "lint": "eslint .",
    "ops:status": "psql \"$DATABASE_URL\" -f scripts/ops-status.sql",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.68.0",
    "@rop/contracts": "workspace:^",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "square": "^44.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.4.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.10"
  }
}
