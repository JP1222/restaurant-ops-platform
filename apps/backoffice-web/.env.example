# Cookie used to identify backoffice sessions. Distinct from KDS so local
# dev with localhost:3000 (kds-web) and localhost:3001 (backoffice-web)
# don't collide.
BACKOFFICE_SESSION_COOKIE_NAME=rop_backoffice_session

# Challenge cookie for passkey login. Keep this distinct from KDS as well.
BACKOFFICE_WEBAUTHN_FLOW_COOKIE_NAME=rop_backoffice_webauthn_flow

# Service-to-service auth for analytics-api. Use the same value as
# analytics-api's ADMIN_TOKEN env var.
ANALYTICS_ADMIN_TOKEN=

# Internal URL where backoffice's BFF reaches analytics-api.
# Local dev (analytics-api on :3100):
INTERNAL_ANALYTICS_API_URL=http://localhost:3100
# Production (Docker compose service network):
# INTERNAL_ANALYTICS_API_URL=http://analytics-api:8080

# Service-to-service auth for kds-api admin surface (Phase 4 backoffice-admin).
# Generate with: openssl rand -hex 32
# Must match kds-api's KDS_INTERNAL_ADMIN_TOKEN env var exactly.
KDS_INTERNAL_ADMIN_TOKEN=

# Internal URL where backoffice's BFF reaches kds-api.
# Local dev:
INTERNAL_KDS_API_URL=http://localhost:4000
# Production (Docker compose container name):
# INTERNAL_KDS_API_URL=http://rop-kds-api-1:4000

# Same DATABASE_URL as kds-api - sessions and users share the KDS auth store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rop_kds?schema=public

# Same Redis as kds-api - session IDs and WebAuthn challenges live here.
REDIS_URL=redis://localhost:6379

# Session signing secret. Keep aligned with KDS before Phase 6+ SSO work.
SESSION_SECRET=

# WebAuthn relying party config. For local dev:
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Example Kitchen Backoffice
WEBAUTHN_ORIGIN=http://localhost:3001

# --- AI Assistant (DeepSeek — ADR-0017, key source superseded by #265) ---
# PRIMARY source is the `ai.deepseek_api_key` AppSetting row (category=secret,
# AES-GCM encrypted): set it in the Backoffice UI at /settings/system. The env
# var below is a DEPRECATED transition fallback for environments that still pin
# the key in the host .env — the DB row wins when both are present, and this var
# will be dropped once every environment has migrated. Without either, POST
# /api/ai/chat returns 503 auth_not_configured. Get a key at
# https://platform.deepseek.com.
DEEPSEEK_API_KEY=

# Optional runtime tunables. These are AppSetting-backed (ADR-0016): the DB
# `app_setting` row wins, then the env var below, then the registry default in
# packages/contracts/src/settings.ts. Listed as <AppSetting key> — <default>.
#
# ai.model_id — deepseek-v4-pro (alternative: deepseek-v4-flash)
DEEPSEEK_MODEL_ID=deepseek-v4-pro
# ai.max_output_tokens — 4000 (hard cap on tokens per assistant turn)
AI_MAX_OUTPUT_TOKENS=4000
# ai.rate_limit_per_minute — 10 (global RPM ceiling across all operators)
AI_RATE_LIMIT_PER_MINUTE=10
# ai.kill_switch — false (set "true" to make /api/ai/chat return 503 immediately)
AI_MONTHLY_SPEND_KILL_SWITCH=false
# ai.thinking_mode — false (enable DeepSeek chain-of-thought reasoning)
AI_THINKING_MODE=false
# ai.system_prompt_append — "" (operator text appended to the base system prompt)
AI_SYSTEM_PROMPT_APPEND=

# --- Ops Pipeline dashboard ---
# Read-only PAT for the GH Actions + GHCR sources of the /ops Pipeline tab.
# Optional: when unset, the page still works (public-repo workflow runs are
# readable unauthenticated at 60 req/h/IP) but GHCR image versions require
# `read:packages` scope. Recommended scopes: `actions:read`, `read:packages`.
GITHUB_PIPELINE_TOKEN=

# Repo coordinates the dashboard reads from. Defaults match the production
# example-org/restaurant-ops-platform deployment.
GITHUB_REPO_OWNER=example-org
GITHUB_REPO_NAME=restaurant-ops-platform

# --- AppSetting at-rest encryption (ADR-0016 + issue #244) ---
# REQUIRED in any environment that writes or reads `app_setting` rows whose
# category is `secret` (e.g. AI provider API keys, Clover OAuth tokens). The
# backoffice fails fast at module load when a route touches secrets without
# this set. 32-byte hex (64 chars). Generate with:
#   openssl rand -hex 32
# Loss of this key = every encrypted row becomes unreadable; store in a
# password manager out-of-band. Distinct from AI_TOKEN_ENCRYPTION_KEY (that
# protects ai_auth_profiles + kds_provider_configs; this one protects
# app_setting rows). Two distinct keys means a leak of one doesn't
# compromise the other.
APP_SETTING_ENCRYPTION_KEY=

# OPTIONAL — used only during key rotation. When set, decrypt attempts that
# fail with the primary key fall back to this one before raising
# SettingDecryptError. Rotation procedure: generate new key, set new key as
# APP_SETTING_ENCRYPTION_KEY, move old key to APP_SETTING_ENCRYPTION_KEY_PREVIOUS,
# redeploy, re-write every secret row (PUT /api/settings) so it's encrypted
# under the new key, then drop APP_SETTING_ENCRYPTION_KEY_PREVIOUS on the
# next deploy.
APP_SETTING_ENCRYPTION_KEY_PREVIOUS=
