{
  "name": "@rop/inventory-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=yr-src' tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@sentry/node": "^10.68.0",
    "@rop/auth": "workspace:*",
    "@rop/contracts": "workspace:*",
    "@rop/db-inventory": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.2",
    "tsx": "^4.23.1"
  }
}
