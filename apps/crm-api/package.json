{
  "name": "@rop/crm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=yr-src' tsx watch src/index.ts",
    "dev:worker": "NODE_OPTIONS='--conditions=yr-src' tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@sentry/node": "^10.73.0",
    "@rop/contracts": "workspace:*",
    "@rop/db-crm": "workspace:*",
    "bullmq": "^5.81.2",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.2",
    "tsx": "^4.23.13"
  }
}
