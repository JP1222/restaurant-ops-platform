# Copy to .env.observability on Oracle:
#   cp .env.observability.example .env.observability
#   # then fill in the required values

# === REQUIRED ===

# Grafana admin password (admin user is "admin"). Generate with:
#   openssl rand -base64 24
# You'll log into Grafana at https://metrics.example.com with this.
GRAFANA_ADMIN_PASSWORD=


# === OPTIONAL ===

# How long Prometheus retains scraped metrics. Default 30d.
PROMETHEUS_RETENTION=30d

# Slack incoming webhook for Alertmanager → Slack alert routing. SAME value as
# the SLACK_WEBHOOK_URL repo secret and the host ~/.rop-alert.env (the
# health cron). Without it, Alertmanager still runs but cannot post to Slack
# (alerts stay in /alerts + Grafana). Create at https://api.slack.com/apps →
# Incoming Webhooks.
SLACK_WEBHOOK_URL=
